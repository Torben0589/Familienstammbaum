# SQLite-Datenbankdatei (wird im Docker-Volume ./data abgelegt)
DATABASE_URL="file:/app/data/familienstammbaum.db"

# NextAuth: einmalig generieren mit `openssl rand -base64 32` und geheim halten
NEXTAUTH_SECRET="bitte-mit-openssl-rand--base64-32-ersetzen"

# Die URL, unter der die App erreichbar ist (lokal, VPN oder Domain)
NEXTAUTH_URL="http://raspberrypi.local:3000"
