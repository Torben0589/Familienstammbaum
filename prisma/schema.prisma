// Prisma Schema - Familienstammbaum
// Datenbank: SQLite (lokal auf dem Raspberry Pi, Datei liegt im ./data Volume)
//
// Hinweis: SQLite unterstützt in Prisma keine nativen "enum"-Typen.
// Die frueheren Enums (Gender, PartnershipType, ChildRelationType) wurden
// daher durch String-Felder ersetzt. Die Gueltigkeit der Werte wird weiterhin
// ueber Zod in den API-Routen geprueft (siehe src/app/api/**).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Person {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  birthName   String?
  gender      String   @default("UNKNOWN")
  birthDate   String?
  birthPlace  String?
  deathDate   String?
  deathPlace  String?
  occupation  String?
  notes       String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asParent1   Couple[]      @relation("Parent1")
  asParent2   Couple[]      @relation("Parent2")
  parentLinks ParentChild[] @relation("ChildLink")
  childLinks  ParentChild[] @relation("ParentLink")

  @@index([lastName, firstName])
}

model Couple {
  id         String  @id @default(cuid())
  type       String  @default("MARRIED")
  startDate  String?
  startPlace String?
  endDate    String?
  notes      String?

  parent1Id String
  parent1   Person @relation("Parent1", fields: [parent1Id], references: [id], onDelete: Cascade)
  parent2Id String
  parent2   Person @relation("Parent2", fields: [parent2Id], references: [id], onDelete: Cascade)

  children ParentChild[]

  createdAt DateTime @default(now())

  @@unique([parent1Id, parent2Id])
}

model ParentChild {
  id       String  @id @default(cuid())
  childId  String
  child    Person  @relation("ChildLink", fields: [childId], references: [id], onDelete: Cascade)
  parentId String
  parent   Person  @relation("ParentLink", fields: [parentId], references: [id], onDelete: Cascade)
  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  relation String  @default("BIOLOGICAL")

  @@unique([childId, parentId])
}
