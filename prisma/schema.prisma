// Prisma Schema - Familienstammbaum
// Datenbank: SQLite (lokal auf dem Raspberry Pi, Datei liegt im ./data Volume)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Ein Benutzerkonto der Familie. Alle Benutzer haben gleiche Rechte (kein Rollensystem).
model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

// Eine Person im Stammbaum
model Person {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  birthName   String? // Geburtsname, falls abweichend vom Nachnamen
  gender      Gender   @default(UNKNOWN)
  birthDate   String? // als Freitext/ISO gespeichert, da oft nur Jahr/ungefähr bekannt
  birthPlace  String?
  deathDate   String?
  deathPlace  String?
  occupation  String? // Beruf
  notes       String?
  photoUrl    String? // vorbereitet für später, aktuell ungenutzt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asParent1   Couple[]      @relation("Parent1")
  asParent2   Couple[]      @relation("Parent2")
  parentLinks ParentChild[] @relation("ChildLink")
  childLinks  ParentChild[] @relation("ParentLink")

  @@index([lastName, firstName])
}

enum PartnershipType {
  MARRIED
  PARTNERED
  DIVORCED
  SEPARATED
}

// Verbindung zwischen zwei Personen (Paar/Ehe), dient auch als Eltern-Gruppierung
model Couple {
  id        String          @id @default(cuid())
  type      PartnershipType @default(MARRIED)
  startDate String?
  startPlace String?
  endDate   String?
  notes     String?

  parent1Id String
  parent1   Person @relation("Parent1", fields: [parent1Id], references: [id], onDelete: Cascade)
  parent2Id String
  parent2   Person @relation("Parent2", fields: [parent2Id], references: [id], onDelete: Cascade)

  children ParentChild[]

  createdAt DateTime @default(now())

  @@unique([parent1Id, parent2Id])
}

enum ChildRelationType {
  BIOLOGICAL
  ADOPTED
  STEP
}

// Eltern-Kind-Beziehung. coupleId optional, falls nur ein Elternteil bekannt ist (dann über parentId direkt)
model ParentChild {
  id       String            @id @default(cuid())
  childId  String
  child    Person            @relation("ChildLink", fields: [childId], references: [id], onDelete: Cascade)
  parentId String
  parent   Person            @relation("ParentLink", fields: [parentId], references: [id], onDelete: Cascade)
  coupleId String?
  couple   Couple?           @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  relation ChildRelationType @default(BIOLOGICAL)

  @@unique([childId, parentId])
}
